[submodule "external/freetds"]
	path = external/freetds
	url = https://github.com/FreeTDS/freetds.git
	ignore = dirty
[submodule "external/odpi"]
	path = external/odpi
	url = https://github.com/oracle/odpi.git
[submodule "external/cassandra-cpp-driver"]
	path = external/cassandra-cpp-driver
	url = https://github.com/datastax/cpp-driver.git
[submodule "external/libpg_query"]
	path = external/libpg_query
	url = https://github.com/pganalyze/libpg_query.git
